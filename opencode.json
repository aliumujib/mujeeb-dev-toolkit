{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-4-20250514",
  "theme": "opencode",
  "autoupdate": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git checkout .*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "rm -rf*": "ask",
      "rm -fr*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "instructions": [
    "AGENTS.md"
  ]
}
